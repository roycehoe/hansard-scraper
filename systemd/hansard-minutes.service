# The home minutes run (docs/refresh.md, "The home minutes run"). It runs the
# code at origin/master from its own worktree, never the shared checkout, and
# pings healthchecks.io with the script's exit code, as refresh.sh does.
[Unit]
Description=Open Hansard minutes run from the home desktop

[Service]
Type=oneshot
WorkingDirectory=%h/ghq/github.com/roycehoe/hansard-scraper-wt-minutes
ExecStartPre=/usr/bin/git -C %h/ghq/github.com/roycehoe/hansard-scraper-wt-minutes checkout --quiet --force --detach origin/master
ExecStart=/bin/bash -c 'set -a; . %h/.config/hansard/.env; set +a; DATABASE_URL="$$PRODUCTION_REFRESH_DATABASE_URL" %h/ghq/github.com/roycehoe/hansard-scraper/.venv/bin/python refresh_minutes.py --commit; code=$$?; if [ -n "$$HEALTHCHECKS_MINUTES_PING_URL" ]; then /usr/bin/curl -fsS -m 10 --retry 3 -o /dev/null "$$HEALTHCHECKS_MINUTES_PING_URL/$$code"; fi; exit $$code'
Nice=10
TimeoutStartSec=30min
