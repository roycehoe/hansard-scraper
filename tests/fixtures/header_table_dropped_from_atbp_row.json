  "html": "<html><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\r\n\r\n<head>\r\n\r\n\r\n\r\n<meta http-equiv=\"Content-Type\" content=\"text/html;charset=iso-8859-1\">\r\n\r\n<meta name=\"Parl_No\" content=\"5\">\r\n\r\n<meta name=\"Sess_No\" content=\"1\">\r\n\r\n<meta name=\"Vol_No\" content=\"43\">\r\n\r\n<meta name=\"Sit_No\" content=\"5\">\r\n\r\n<meta name=\"Sit_Date\" content=\"1984-03-02\">\r\n\r\n<meta name=\"Sect_Name\" content=\"ASSENTS TO BILLS PASSED\">\r\n\r\n<meta name=\"Title\" content=\"ASSENTS TO BILLS PASSED\">\r\n\r\n<meta name=\"MP_Speak\" content=\"\">\r\n\r\n<meta name=\"Start_Col\" content=\"403\">\r\n\r\n<meta name=\"End_Col\" content=\"404\">\r\n\r\n</head>\r\n\r\n<body>\r\n\r\n\r\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td>&nbsp;</td></tr></table><table width=\"100%\" border=\"1\" cellpadding=\"1\" cellspacing=\"0\" bordercolor=\"#000000\"><tr><td>\r\n\r\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Parliament No:</font></td><td width=\"85%\"><font size=\"2\">5</font></td></tr>\r\n\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Session No:</font></td><td width=\"85%\"><font size=\"2\">1</font></td></tr>\r\n\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Volume No:</font></td><td width=\"85%\"><font size=\"2\">43</font></td></tr>\r\n\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Sitting No:</font></td><td width=\"85%\"><font size=\"2\">5</font></td></tr>\r\n\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Sitting Date:</font></td><td width=\"85%\"><font size=\"2\">02-03-1984</font></td></tr>\r\n\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Section Name:</font></td><td width=\"85%\"><font size=\"2\">ASSENTS TO BILLS PASSED</font></td></tr>\r\n\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Title:</font></td><td width=\"85%\"><font size=\"2\">ASSENTS TO BILLS PASSED</font></td></tr>\r\n\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">MPs Speaking:</font></td><td width=\"85%\"><font size=\"2\">&nbsp;</font></td></tr>\r\n\r\n</table></td></tr>\r\n\r\n</table>\r\n\r\n<br><br><font size=\"1\"><b>Column: 403</b></font><br><br>\r\n\r\n\r\n\r\n<div align=\"center\"><h4>ASSENTS TO BILLS PASSED</h4></div>\r\n\r\n\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;The following Bills were assented to by\r\n\r\nthe President of the Republic of Singapore\r\n\r\non the dates stated:-\r\n\r\n\r\n\r\n<br><br>23rd January, 1984\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;The Statutory Boards (Taxable Services) (Amendment) Bill.\r\n\r\n\r\n\r\n<br><br>14th February,1984\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;(i) The Banking (Amendment) Bill;\r\n\r\n   \r\n\r\n<br><br><font size=\"1\"><b>Column: 404</b></font><br><br>\r\n\r\n\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;(ii) The Construction Industry Development Board Bill;\r\n\r\n\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;(iii) The Post Office Savings Bank of Singapore (Amendment) Bill; and\r\n\r\n\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;(iv) The Factories (Amendment) Bill.\r\n\r\n\r\n\r\n\r\n\r\n<br><br><table width=\"80%\" border=\"0\" cellspacing=\"0\" cellpadding=\"1\"><tr><td width=\"70%\">&nbsp;</td><td width=\"30%\"><div align=\"center\">YEOH GHIM SENG</div></td></tr>\r\n\r\n<tr><td width=\"70%\">&nbsp;</td><td width=\"30%\"><div align=\"center\"><i>Speaker,</i></div></td></tr>\r\n\r\n<tr><td width=\"70%\">&nbsp;</td><td width=\"30%\"><div align=\"center\"><i>Parliament of Singapore</i></div></td></tr></table>\r\n\r\n\r\n\r\n<hr align=\"center\" width=\"30%\" size=\"2\" noshade>\r\n\r\n\r\n\r\n</body>\r\n\r\n</html>\r\n\r\n",
