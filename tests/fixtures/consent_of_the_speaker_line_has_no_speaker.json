  "html": "<html><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\r\n<head>\r\n\r\n<meta http-equiv=\"Content-Type\" content=\"text/html;charset=iso-8859-1\">\r\n<meta name=\"Parl_No\" content=\"4\">\r\n<meta name=\"Sess_No\" content=\"2\">\r\n<meta name=\"Vol_No\" content=\"38\">\r\n<meta name=\"Sit_No\" content=\"5\">\r\n<meta name=\"Sit_Date\" content=\"1979-01-12\">\r\n<meta name=\"Sect_Name\" content=\"MOTIONS\">\r\n<meta name=\"Title\" content=\"ADJOURNMENT MOTION\">\r\n<meta name=\"MP_Speak\" content=\"Mr E. W. Barker (Leader of the House);\">\r\n<meta name=\"Start_Col\" content=\"173\">\r\n<meta name=\"End_Col\" content=\"173\">\r\n</head>\r\n<body>\r\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td>&nbsp;</td></tr></table><table width=\"100%\" border=\"1\" cellpadding=\"1\" cellspacing=\"0\" bordercolor=\"#000000\"><tr><td>\r\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Parliament No:</font></td><td width=\"85%\"><font size=\"2\">4</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Session No:</font></td><td width=\"85%\"><font size=\"2\">2</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Volume No:</font></td><td width=\"85%\"><font size=\"2\">38</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Sitting No:</font></td><td width=\"85%\"><font size=\"2\">5</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Sitting Date:</font></td><td width=\"85%\"><font size=\"2\">12-01-1979</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Section Name:</font></td><td width=\"85%\"><font size=\"2\">MOTIONS</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Title:</font></td><td width=\"85%\"><font size=\"2\">ADJOURNMENT MOTION</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">MPs Speaking:</font></td><td width=\"85%\"><font size=\"2\">Mr E. W. Barker (Leader of the House);</font></td></tr>\r\n</table></td></tr>\r\n</table>\r\n<br><br><font size=\"1\"><b>Column: 173</b></font><br><br>\r\n\r\n\r\n<div align=\"center\"><b>ADJOURNMENT MOTION</b></div>\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;With the consent of the Speaker and the\r\ngeneral assent of Members present, Motion\r\nmade, and Question put.\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;Resolved,\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;\"That, notwithstanding the Standing Orders, this\r\nHouse do adjourn at 4.30 p.m. today.\" - [Mr E.W.\r\nBarker].\r\n\r\n\r\n\r\n</body>\r\n</html>\r\n",
