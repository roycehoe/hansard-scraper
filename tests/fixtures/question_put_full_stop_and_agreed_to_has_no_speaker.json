  "html": "<html><meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\r\n<head>\r\n\r\n<meta http-equiv=\"Content-Type\" content=\"text/html;charset=iso-8859-1\">\r\n<meta name=\"Parl_No\" content=\"5\">\r\n<meta name=\"Sess_No\" content=\"1\">\r\n<meta name=\"Vol_No\" content=\"41\">\r\n<meta name=\"Sit_No\" content=\"2\">\r\n<meta name=\"Sit_Date\" content=\"1981-06-15\">\r\n<meta name=\"Sect_Name\" content=\"MOTIONS\">\r\n<meta name=\"Title\" content=\"ADJOURNMENT DEBATE (Exemption from Standing Orders)\">\r\n<meta name=\"MP_Speak\" content=\"Mr E. W. Barker (Minister for Law and Leader of the House);\">\r\n<meta name=\"Start_Col\" content=\"44\">\r\n<meta name=\"End_Col\" content=\"44\">\r\n</head>\r\n<body>\r\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td>&nbsp;</td></tr></table><table width=\"100%\" border=\"1\" cellpadding=\"1\" cellspacing=\"0\" bordercolor=\"#000000\"><tr><td>\r\n<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Parliament No:</font></td><td width=\"85%\"><font size=\"2\">5</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Session No:</font></td><td width=\"85%\"><font size=\"2\">1</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Volume No:</font></td><td width=\"85%\"><font size=\"2\">41</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Sitting No:</font></td><td width=\"85%\"><font size=\"2\">2</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Sitting Date:</font></td><td width=\"85%\"><font size=\"2\">15-06-1981</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Section Name:</font></td><td width=\"85%\"><font size=\"2\">MOTIONS</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">Title:</font></td><td width=\"85%\"><font size=\"2\">ADJOURNMENT DEBATE (Exemption from Standing Orders)</font></td></tr>\r\n<tr valign=\"top\"><td width=\"15%\"><font size=\"2\">MPs Speaking:</font></td><td width=\"85%\"><font size=\"2\">Mr E. W. Barker (Minister for Law and Leader of the House);</font></td></tr>\r\n</table></td></tr>\r\n</table>\r\n<br><br><font size=\"1\"><b>Column: 44</b></font><br><br>\r\n\r\n<div align=\"center\"><b>ADJOURNMENT DEBATE</b></div>\r\n<div align=\"center\"><b>(Exemption from Standing Orders)</b></div>\r\n\r\n<br><br><!-- Mr E.W. Barker (Minister for Law and Leader of the House) -->&nbsp;&nbsp;&nbsp;&nbsp;<b>The Minister for Law and Leader of the House (Mr E.W. Barker):</b> Mr Deputy\r\nSpeaker, Sir, I beg to move,\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;Question put. and agreed to.\r\n\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;Resolved,\r\n<br><br>&nbsp;&nbsp;&nbsp;&nbsp;That the proceedings on the matter proposed to be\r\nraised on the motion for the adjournment of Parliament\r\nthis day be exempted from the time limits laid down in\r\nparagraph (8) (b) of Standing Order No. 1.\r\n\r\n</body>\r\n</html>\r\n\r\n\r\n</body>\r\n\r\n</html>",
